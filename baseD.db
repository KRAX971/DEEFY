-- ============================================================================
-- 4. RESYNCHRONISATION DES SÉQUENCES AUTO-INCREMENT (Oracle 12c+)
-- ============================================================================
ALTER TABLE playlist MODIFY (id GENERATED BY DEFAULT AS IDENTITY (START WITH LIMIT VALUE));
ALTER TABLE track MODIFY (id GENERATED BY DEFAULT AS IDENTITY (START WITH LIMIT VALUE));
ALTER TABLE users MODIFY (id GENERATED BY DEFAULT AS IDENTITY (START WITH LIMIT VALUE));