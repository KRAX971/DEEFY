-- ============================================================================
-- 1. NETTOYAGE DES TABLES EXISTANTES (ordre inverse des dépendances)
-- ============================================================================
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE user2playlist CASCADE CONSTRAINTS PURGE';
EXCEPTION WHEN OTHERS THEN NULL;
END;
/
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE playlist2track CASCADE CONSTRAINTS PURGE';
EXCEPTION WHEN OTHERS THEN NULL;
END;
/
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE users CASCADE CONSTRAINTS PURGE';
EXCEPTION WHEN OTHERS THEN NULL;
END;
/
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE track CASCADE CONSTRAINTS PURGE';
EXCEPTION WHEN OTHERS THEN NULL;
END;
/
BEGIN
   EXECUTE IMMEDIATE 'DROP TABLE playlist CASCADE CONSTRAINTS PURGE';
EXCEPTION WHEN OTHERS THEN NULL;
END;
/

-- ============================================================================
-- 2. CRÉATION DES TABLES
-- ============================================================================

CREATE TABLE playlist (
  id NUMBER(11) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  nom VARCHAR2(100) NOT NULL
);

CREATE TABLE track (
  id NUMBER(11) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  titre VARCHAR2(100) NOT NULL,
  genre VARCHAR2(30) DEFAULT NULL,
  duree NUMBER(3) DEFAULT NULL,
  filename VARCHAR2(100) DEFAULT NULL,
  type VARCHAR2(30) DEFAULT NULL,
  artiste_album VARCHAR2(30) DEFAULT NULL,
  titre_album VARCHAR2(30) DEFAULT NULL,
  annee_album NUMBER(4) DEFAULT NULL,
  numero_album NUMBER(11) DEFAULT NULL,
  auteur_podcast VARCHAR2(100) DEFAULT NULL,
  date_posdcast DATE DEFAULT NULL
);

-- Note : "User" étant un mot-clé réservé sous Oracle, la table est nommée "users"
CREATE TABLE users (
  id NUMBER(11) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  email VARCHAR2(256) NOT NULL,
  passwd VARCHAR2(256) NOT NULL,
  role NUMBER(11) DEFAULT 1 NOT NULL
);

CREATE TABLE playlist2track (
  id_pl NUMBER(11) NOT NULL,
  id_track NUMBER(11) NOT NULL,
  no_piste_dans_liste NUMBER(3) NOT NULL,
  CONSTRAINT pk_playlist2track PRIMARY KEY (id_pl, id_track),
  CONSTRAINT playlist2track_ibfk_1 FOREIGN KEY (id_pl) REFERENCES playlist (id),
  CONSTRAINT playlist2track_ibfk_2 FOREIGN KEY (id_track) REFERENCES track (id)
);

CREATE INDEX idx_pl2track_track ON playlist2track (id_track);

CREATE TABLE user2playlist (
  id_user NUMBER(11) NOT NULL,
  id_pl NUMBER(11) NOT NULL,
  CONSTRAINT pk_user2playlist PRIMARY KEY (id_user, id_pl),
  CONSTRAINT user2playlist_ibfk_1 FOREIGN KEY (id_user) REFERENCES users (id),
  CONSTRAINT user2playlist_ibfk_2 FOREIGN KEY (id_pl) REFERENCES playlist (id)
);

CREATE INDEX idx_user2pl_pl ON user2playlist (id_pl);

